{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/api",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../shared/**/*.spec.ts"]
}
